# Example only. Do not commit a real key.
# scripts/up.sh creates Secret/cursor-workers-api-key from CURSOR_API_KEY or KEY_FILE.
# To create it yourself:
#   kubectl -n cursord create secret generic cursor-workers-api-key \
#     --from-literal=api-key="$CURSOR_API_KEY"
apiVersion: v1
kind: Secret
metadata:
  name: cursor-workers-api-key
  namespace: cursord
type: Opaque
stringData:
  api-key: REPLACE_ME
