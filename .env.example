# Copy to .env (gitignored) or export these in your shell.
# Pool workers need a service-account API key:
# https://cursor.com/docs/account/enterprise/service-accounts

CURSOR_API_KEY=

# Alternative to CURSOR_API_KEY. The scripts have no default path.
# KEY_FILE=./secrets/cursor-api-key.txt

# Team pool name. Must match POOL_NAME in manifests/deployment.yaml (kind-demo).
POOL=kind-demo

# Set to 1 to skip the demo-only queue-scaler.
# SKIP_QUEUE_SCALER=1
